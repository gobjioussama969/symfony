{% extends 'base.html.twig' %}

{% block title %}Registration index{% endblock %}

{% block body %}
    <h1>Registration index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Date</th>
                <th>State</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for registration in registrations %}
            <tr>
                <td>{{ registration.id }}</td>
                <td>{{ registration.date ? registration.date|date('Y-m-d') : '' }}</td>
                <td>{{ registration.state }}</td>
                <td>
                    <a href="{{ path('app_registration_crud_show', {'id': registration.id}) }}">show</a>
                    <a href="{{ path('app_registration_crud_edit', {'id': registration.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_registration_crud_new') }}">Create new</a>
{% endblock %}

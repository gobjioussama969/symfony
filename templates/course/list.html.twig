{% extends 'base.html.twig' %}

{% block title %}Courses | My University{% endblock %}

{% block content %}
  <h1>Courses</h1>
  <ul>
    {% for c in courses %}
      <li><a href="{{ path('course_detail', {'id': c.id}) }}">{{ c.title }}</a> ({{ c.semester }})</li>
    {% else %}
      <li>No courses available.</li>
    {% endfor %}
  </ul>
{% endblock %}

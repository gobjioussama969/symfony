{% extends 'base.html.twig' %}

{% block content %}
The Students are :

<ul>
    {% for s in students %}
        <li>
            {{ s | upper}}
        </li>
        {% else %}
        <strong>This list is empty</strong>
    {% endfor %}
</ul>

<h1>Here the list of courses :</h1>
<table border="2">
    <tr>
        <th>Id</th>
        <th>Course</th>
        <th>Hours</th>
        <th>Teacher</th>
        <th>Assignment</th>
    </tr>
    {% for c in courses %}
        <tr>
            <td>{{ c.id }}</td>
            <td>{{ c.course }}</td>
            <td>{{ c.Hours }}</td>
            <td>{{ c.teacher }}</td>
            <td><a href="{{ path('assignment') }}">Assignment</a></td>
        </tr>
    {% endfor %}
</table>
{% endblock %}
